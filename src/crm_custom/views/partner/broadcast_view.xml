<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_broadcast_tree" model="ir.ui.view">
        <field name="name">partner.broadcast.tree</field>
        <field name="model">partner.broadcast</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'pending'"
                    decoration-warning="state == 'running'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'failed'"/>
                <field name="total_recipients"/>
                <field name="line_sent"/>
                <field name="line_failed"/>
                <field name="coupon_granted"/>
            </list>
        </field>
    </record>

    <record id="view_partner_broadcast_form" model="ir.ui.view">
        <field name="name">partner.broadcast.form</field>
        <field name="model">partner.broadcast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ('pending', 'running')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,pending,running,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="dry_run" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_recipients" readonly="1"/>
                            <field name="processed" readonly="1"/>
                            <field name="coupon_granted" readonly="1"/>
                            <field name="line_sent" readonly="1"/>
                            <field name="line_failed" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="message_type" readonly="1"/>
                        <field name="message_text" readonly="1"/>
                        <field name="flex_payload" readonly="1"/>
                        <field name="attach_image_url" readonly="1"/>
                        <field name="include_coupon" readonly="1"/>
                        <field name="coupon_id" readonly="1"/>
                    </group>
                    <group string="Errors" invisible="not preflight_error and not last_error">
                        <field name="preflight_error" readonly="1"/>
                        <field name="last_error" readonly="1"/>
                    </group>
                    <field name="recipient_ids" readonly="1">
                        <list>
                            <field name="user_id"/>
                            <field name="line_user_id"/>
                            <field name="coupon_status"/>
                            <field name="line_status"/>
                            <field name="line_error"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_broadcast" model="ir.actions.act_window">
        <field name="name">Broadcasts</field>
        <field name="res_model">partner.broadcast</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_partner_birthday_reward_tree" model="ir.ui.view">
        <field name="name">partner.birthday.reward.tree</field>
        <field name="model">partner.birthday.reward</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="coupon_id"/>
                <field name="min_membership_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_partner_birthday_reward_form" model="ir.ui.view">
        <field name="name">partner.birthday.reward.form</field>
        <field name="model">partner.birthday.reward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="coupon_id"/>
                            <field name="min_membership_days"/>
                        </group>
                    </group>
                    <group string="LINE Reminder (sent on birthday morning)">
                        <field name="message_type"/>
                        <field name="message_text"/>
                        <field name="flex_payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_birthday_reward" model="ir.actions.act_window">
        <field name="name">Birthday Rewards</field>
        <field name="res_model">partner.birthday.reward</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
