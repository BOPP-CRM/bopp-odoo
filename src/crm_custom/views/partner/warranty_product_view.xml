<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_warranty_product_form" model="ir.ui.view">
        <field name="name">partner.warranty.product.form</field>
        <field name="model">partner.warranty.product</field>
        <field name="arch" type="xml">
            <form string="Warranty Product">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="name"/>
                            <field name="sku"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="image_file" widget="image" options="{'size': [128, 128]}"/>
                            <field name="image" invisible="1"/>
                            <field name="cost_price"/>
                            <field name="sell_price"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Serial Number Patterns">
                        <p class="text-muted">
                            ใช้ # แทนตัวเลข, ? แทนตัวอักษร/ตัวเลข 1 ตัว, * แทนตัวอักษร/ตัวเลขใด ๆ
                            หากไม่กำหนดรูปแบบ ระบบจะไม่ตรวจสอบ Serial Number
                        </p>
                        <field name="sn_pattern_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="pattern"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
