<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_partner_birthday_reminder" model="ir.cron">
        <field name="name">Partner Birthday LINE Reminder</field>
        <field name="model_id" ref="model_partner_birthday_reward"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_birthday_line_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1))"/>
        <field name="active">True</field>
    </record>
</odoo>
