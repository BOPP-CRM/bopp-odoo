SERVICE=server
# 1 = try PyCharm/IDE remote debug on host.docker.internal:5678 (Odoo still starts if nothing is listening)
DEBUG=0
PYDEVD_DISABLE_FILE_VALIDATION=1
BACKEND_PATH=
FRONTEND_PATH=
PORTAL_FRONTEND_PATH=
# Used for portal-facing URLs (invite links, Zortout webhooks via portal /api/* proxy)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-southeast-1
AWS_S3_PUBLIC_URL=
AWS_S3_PREFIX=crm
PORTAL_TOKEN_EXPIRE_HOURS=168
PORTAL_INVITE_EXPIRE_HOURS=72

# Gody SMS OTP (openapi send/verify + balance)
SMS_API_ENDPOINT=https://apiv2.godysms.com
SMS_API_TOKEN=
SMS_APP_KEY=
SMS_APP_SECRET=

# ThaiBulkSMS OTP API (otp.thaibulksms.com) — default pulls corporate credit unless force is set
THAIBULKSMS_OTP_ENDPOINT=https://otp.thaibulksms.com
THAIBULKSMS_OTP_KEY=
THAIBULKSMS_OTP_SECRET=
# standard | corporate — use standard to deduct Standard SMS credits (per ThaiBulkSMS OTP API)
THAIBULKSMS_OTP_FORCE=standard

# ThaiBulkSMS SMS API v2 (optional; used to pre-check Standard balance when OTP_FORCE=standard)
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=

EMAIL_API_ENDPOINT=https://api.resend.com
EMAIL_API_TOKEN=

LAZADA_APP_KEY=
LAZADA_APP_SECRET=
