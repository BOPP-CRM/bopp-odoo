[options]
db_host = db
db_port = 5432
db_user = odoo
db_password = odoo
db_sslmode = disable
db_name = crm_backend
db_maxconn = 200
limit_time_real = 1200
limit_time_cpu = 600
gevent_port = 8072
longpolling_port = 8072

workers = 0

addons_path = /mnt/extra-addons
# Loaded at process start. Tracing stays off unless OTEL_ENABLED=true.
server_wide_modules = base,web,otel_tracing
data_dir = /var/lib/odoo
log_level = debug
